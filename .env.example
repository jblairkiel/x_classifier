# tl-ai-detector settings. Copy to .env (never commit .env) and fill in the REQUIRED values.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------- site / proxy
# REQUIRED. Public hostname; needs a DNS A record pointing at this server.
DOMAIN=x.jblairkiel.com
# REQUIRED. Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------- admin login
ADMIN_USERNAME=admin
# REQUIRED. argon2 hash, generate with:  make hash-password   (or: tl hash-password)
# Wrap it in single quotes because it contains "$" characters.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
# REQUIRED. >= 32 random chars:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs everyone out.
SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
SESSION_MAX_AGE_HOURS=12
# Keep true in production (cookie only sent over HTTPS). Only set false for plain-http local dev.
COOKIE_SECURE=true
# Failed logins allowed per client IP per window, and across all IPs per window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_GLOBAL_MAX_ATTEMPTS=30
LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------- scraper (worker)
# following | for_you
TIMELINE=following
# Name of the Playwright storage-state file inside the secrets volume.
STORAGE_STATE_FILE=x_storage_state.json
# Volume caps. The daily cap is a rolling 24h window across all runs.
SCRAPE_MAX_TWEETS_PER_RUN=60
SCRAPE_MAX_TWEETS_PER_DAY=300
SCRAPE_MAX_SCROLLS_PER_RUN=25
# Stop a run after this many scrolls in a row with nothing new.
SCRAPE_STALE_SCROLLS=3
# Pause between scrolls: uniform random between min and max seconds.
SCROLL_DELAY_MIN_SECONDS=4
SCROLL_DELAY_MAX_SECONDS=11
PAGE_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- schedule (worker)
SCRAPE_ENABLED=true
# Minutes between scheduled runs, +/- a random jitter.
SCRAPE_INTERVAL_MINUTES=240
SCRAPE_INTERVAL_JITTER_MINUTES=45
# Local hours (container TZ) in which scheduled runs may start, "start-end"; "*" = any time.
SCRAPE_ACTIVE_HOURS=08-22
TZ=America/Chicago
WORKER_POLL_SECONDS=20

# ---------------------------------------------------------------- model
# Checkpoint used for inference: "latest" (newest complete checkpoint) or a version name, e.g. v20261004-013000
MODEL_VERSION=latest
# Base model for `tl train` (HF id or a local path inside the train container).
BASE_MODEL=distilroberta-base
MODEL_MAX_LENGTH=128
CLASSIFY_BATCH_SIZE=16
# Score at/above which a tweet is shown as "flagged" by default.
AI_THRESHOLD=0.8

# ---------------------------------------------------------------- build
TL_IMAGE_TAG=latest
# Set 0 to build the worker without torch (scraping only, no inference).
WORKER_WITH_TORCH=1
# CUDA wheel index used by docker-compose.gpu.yml.
TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu128
